# PlayCard 환경 변수 예시 — 실제 값은 .env.local에 작성하세요.

# MongoDB
MONGODB_URI=mongodb://localhost:27017/playcard

# 앱 베이스 URL — Kakao OAuth redirect 계산에 사용
# 로컬: http://localhost:3000
# 운영: https://<배포-도메인>
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Kakao OAuth — https://developers.kakao.com 에서 앱 등록 후 발급
# REST API 키와 (선택) Client Secret을 입력하고
# Kakao 콘솔의 Redirect URI에 ${NEXT_PUBLIC_APP_URL}/api/auth/kakao/callback 등록
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# Google OAuth — https://console.cloud.google.com 에서 OAuth 2.0 Client ID 발급
# 콘솔 "승인된 리디렉션 URI"에 ${NEXT_PUBLIC_APP_URL}/api/auth/google/callback 등록
# 동의 화면 scope: openid, email, profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini AI — 칭호 생성에 사용. 미설정 시 칭호 생성 스킵
GEMINI_API_KEY=

# Cloudinary — 이미지 업로드(선택)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 성능 모니터링(선택)
# API_LOGGING=false   # API 로깅/집계 비활성화
# MONGODB_DEBUG=true  # Mongoose 쿼리 로그 출력
